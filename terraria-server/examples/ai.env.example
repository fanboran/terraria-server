# 扣哒（主 AI）环境配置模板
# 用法：复制为 /opt/terraria/ai.env 并填写真实值；权限建议 600（含密钥）
# systemd 通过 EnvironmentFile=/opt/terraria/ai.env 加载

# ---------- LLM 接入（OpenAI 兼容接口）----------
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=deepseek-ai/DeepSeek-V3.2

# ---------- 身份 ----------
AI_BOT_NAME=扣哒
AI_PERSONA_FILE=/opt/terraria/persona.txt

# ---------- 事件分工 ----------
# 逗号分隔白名单；空=全部事件都播报。扣哒负责昼夜，其余交给小T
AI_EVENTS=day,night
# 白名单外事件的搭话概率（与另一个 AI 分工协作，不抢播）
AI_EVENT_CHIME_PROB=0.4

# ---------- 发言节奏 ----------
AI_REPLY_GAP=20            # 实际发言后的防连击间隔（秒）；LLM 沉默决策不占
AI_EVENT_COOLDOWN=90       # 事件播报冷却（秒）
AI_DEATH_COOLDOWN=45       # 死亡事件冷却（秒）
AI_DEATH_CHIME_PROB=0.05   # 单人死亡旁听概率（死太频繁，基本不吭声）
AI_DEATH_RALLY_N=8         # 窗口内死亡人次达到该值 = 团灭（值得吐槽）
AI_DEATH_RALLY_WINDOW=180  # 团灭判定窗口（秒）

# ---------- 上下文与输出 ----------
AI_HISTORY=6               # 携带的历史聊天条数
AI_MAX_LEN=120             # 单条广播最大长度（游戏内显示限制）
AI_IDLE_PROB=0             # 冷场自说自话概率（0=关闭）

# ---------- 记忆系统 ----------
AI_MEMORY_FILE=/opt/terraria/scripts/memory.txt
AI_MEM_SINCE=/opt/terraria/scripts/.mem_since
AI_MEMORY_MAX=40           # 记忆滚动保留条数
AI_MEMORY_INJECT=12        # 每次注入 prompt 的记忆条数

# ---------- 互斥 ----------
# 同一服务器跑多个 AI 时，屏蔽另一个 AI 的名字，避免把对方当玩家互聊
AI_SKIP=小T

# ---------- 运维 ----------
AI_STATS_URL=http://127.0.0.1:19980
# 杂鱼事件黑名单（正则）：无播报价值的伪 Boss/刷屏事件
AI_IGNORE_EVENTS=Ghost
