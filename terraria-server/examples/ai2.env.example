# 小T（第二 AI）环境配置模板
# 用法：复制为 /opt/terraria/ai2.env；与 ai.env 共用同一份代码，仅配置不同
# 定位：世界意志人格，只在大事（世界级事件）出现，不参与日常闲聊

# ---------- LLM 接入 ----------
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=deepseek-ai/DeepSeek-V3.2

# ---------- 身份 ----------
AI_BOT_NAME=小T
AI_PERSONA_FILE=/opt/terraria/persona2.txt

# ---------- 事件分工：小T 负责世界级事件 ----------
AI_EVENTS=event,start
AI_EVENT_CHIME_PROB=0      # 不旁听别人的事件，保持"大事才现身"的稀缺感

# ---------- 发言节奏 ----------
AI_REPLY_GAP=20
AI_EVENT_COOLDOWN=90
AI_DEATH_COOLDOWN=45
AI_DEATH_CHIME_PROB=0.05
AI_DEATH_RALLY_N=8
AI_DEATH_RALLY_WINDOW=180

# ---------- 上下文与输出 ----------
AI_HISTORY=6
AI_MAX_LEN=120
AI_IDLE_PROB=0

# ---------- 记忆系统（与扣哒共享同一记忆库）----------
AI_MEMORY_FILE=/opt/terraria/scripts/memory.txt
AI_MEM_SINCE=/opt/terraria/scripts/.mem_since
AI_MEMORY_MAX=40
AI_MEMORY_INJECT=12

# ---------- 互斥 ----------
AI_SKIP=扣哒

# ---------- 行为开关 ----------
AI_CHAT_ENABLED=0          # 0=不参与日常闲聊（仅点名时回），保持"只在大事说话"

# ---------- 运维 ----------
AI_STATS_URL=http://127.0.0.1:19980
AI_IGNORE_EVENTS=Ghost
